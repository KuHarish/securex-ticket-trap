REDIS_URL=redis://localhost:6379
# OR for Redis Cloud (if REDIS_HOST is set, it overrides REDIS_URL)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_USERNAME=default
TICKET_SIGNING_SECRET=replace_with_a_strong_secret
BOOKING_REQUEST_LIMIT=5
BOOKING_REQUEST_WINDOW_SECONDS=60
VALIDATION_REQUEST_LIMIT=20
VALIDATION_REQUEST_WINDOW_SECONDS=60
DUPLICATE_REQUEST_WINDOW_SECONDS=5
ABUSE_BLOCK_SECONDS=60
ABUSE_THRESHOLD=5
